#!/bin/sh
# Blocks direct pushes to main once the project is published, so changes go
# through a branch -> Vercel preview -> pull request -> merge.
# Override once with:  ALLOW_MAIN_PUSH=1 git push

[ -n "$ALLOW_MAIN_PUSH" ] && exit 0

# Before the first real publish, origin/main holds only a placeholder README.
# Once it contains package.json the site is live and main becomes protected.
git cat-file -e refs/remotes/origin/main:package.json 2>/dev/null || exit 0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo ""
    echo "Direct pushes to main are blocked, so changes get reviewed first."
    echo "  git switch -c my-change     # work on a branch"
    echo "  git push -u origin my-change"
    echo "Then open the Vercel preview link, and merge the pull request when happy."
    echo ""
    exit 1
  fi
done
exit 0
